# ==========================================
# FastAPI Environment Variables
# ==========================================

# Application Settings
APP_NAME=FastAPI JWT Auth
APP_VERSION=4.0.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# JWT Settings
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:3001"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ==========================================
# Domain Configuration
# ==========================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ==========================================
# Google OAuth Configuration
# ==========================================
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ==========================================
# Email Configuration (SMTP)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# WhatsApp Configuration (Optional)
# ==========================================
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ==========================================
# Database Settings (Future)
# ==========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=mongodb://localhost:27017/auth_db

# ==========================================
# Security Settings
# ==========================================
BCRYPT_ROUNDS=12

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
